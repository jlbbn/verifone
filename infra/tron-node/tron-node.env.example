# Non-secret java-tron runtime configuration.
TRON_HOME=/opt/tron
TRON_DATA_DIR=/var/lib/tron/database
TRON_LOG_DIR=/var/log/tron
TRON_JAVA_XMS=8g
TRON_JAVA_XMX=12g

# Official pinned release (2026-07-31).
TRON_RELEASE=GreatVoyage-v4.8.2.1
TRON_JAR_URL=https://github.com/tronprotocol/java-tron/releases/download/GreatVoyage-v4.8.2.1/FullNode-x64.jar
TRON_JAR_SHA256=834f492b4e547acb69a0d112474bb24723ca9678870d700db6abc98a6ce37743
TRON_CONFIG_URL=https://raw.githubusercontent.com/tronprotocol/java-tron/GreatVoyage-v4.8.2.1/framework/src/main/resources/config.conf
TRON_CONFIG_SHA256=fb51f5ee508cefb4e0d4b0c1868029e385a997ee9b7468875c9d781d77b0ea2a

# Provisioning-only values (not read by java-tron).
ADMIN_SSH_CIDR=REPLACE_WITH_ADMIN_IP/32
TRON_RPC_ALLOWED_CIDR=10.10.0.0/20
TRON_STORAGE_SSD_CONFIRMED=false
TRON_NETWORK_100MBPS_CONFIRMED=false
TRON_ALERT_HOOK_PATH=/usr/local/sbin/tron-node-alert-hook