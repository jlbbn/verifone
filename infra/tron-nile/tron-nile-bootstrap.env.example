# Copy to /etc/tron-nile/bootstrap.env (root:root 0600) before a rebootstrap.
# Values come from the official Nile snapshot index and its HTTP Content-Length.
NILE_SNAPSHOT_URL=https://snapshots.nileex.io/backupYYYYMMDD/LiteFullNode_output-directory.tgz
NILE_SNAPSHOT_MD5=REPLACE_WITH_OFFICIAL_32_HEX_MD5
NILE_SNAPSHOT_BYTES=REPLACE_WITH_OFFICIAL_CONTENT_LENGTH

# Conservative safety caps for the 160 GB experimental disk.
NILE_MAX_EXPANDED_BYTES=128849018880
NILE_RESERVE_BYTES=12884901888
