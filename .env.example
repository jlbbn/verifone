# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string

# ─── OKX Broker ──────────────────────────────────────────────────────────────
OK_API_KEY=your-okx-api-key
OKX_SECRETKEY=your-okx-secret-key-32-char-hex
OKX_API_PASSPHRASE=your-okx-passphrase

# OKX_WEBHOOK_SECRET: secret key for verifying inbound OKX push notifications.
# Set this in the OKX Developer Portal → Webhooks → Secret.
# Without it, webhook signatures cannot be verified (events are logged but ignored).
OKX_WEBHOOK_SECRET=your-okx-webhook-secret

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Email (Resend via Replit Connector) ─────────────────────────────────────
# Configured via Replit Integrations — no manual env var required.
# Optional: set RESEND_FROM to use a custom verified sender domain.
# RESEND_FROM=noreply@yourdomain.com

# ─── SMTP (legacy — replaced by Resend) ──────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMT_USER=user@example.com
# SMT_PASS=password
# SMT_FROM=noreply@example.com
