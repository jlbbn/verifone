# Copiar a /etc/tron-mainnet/bootstrap.env (root:root 0600).
# Valores del indice del mirror oficial y su Content-Length exacto.
SNAPSHOT_URL=http://34.86.86.229/backupYYYYMMDD/LiteFullNode_output-directory.tgz
SNAPSHOT_MD5=REPLACE_32_HEX
SNAPSHOT_BYTES=REPLACE_CONTENT_LENGTH

# Limites para el disco local de 160 GB.
MAX_EXPANDED_BYTES=144955146240
RESERVE_BYTES=12884901888
