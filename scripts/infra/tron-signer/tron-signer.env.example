# This file belongs ONLY on the isolated signer host (chmod 600).
# Never copy TRON_SIGNER_PRIVATE_KEY to Banxico Plus or Replit.
TRON_SIGNER_HOST=REPLACE_WITH_SIGNER_PRIVATE_IP
TRON_SIGNER_PORT=9443
# Use nile only on the dedicated test signer, with its own wallet and state path.
TRON_NETWORK=mainnet
# Nile example: /var/lib/tron-signer/nile-state.json
TRON_SIGNER_STATE_PATH=/var/lib/tron-signer/state.json

TRON_FULL_HOST=http://TRON_NODE_PRIVATE_IP:8090
TRON_APPROVED_NODE_ORIGIN=http://TRON_NODE_PRIVATE_IP:8090
TRON_SIGNER_ADDRESS=T_REPLACE_WITH_PUBLIC_ADDRESS
TRON_SIGNER_PRIVATE_KEY=REPLACE_ON_SIGNER_HOST_ONLY

TRON_SIGNER_KEY_ID=banxico-plus-app-v1
TRON_SIGNER_HMAC_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
TRON_SIGNER_TLS_KEY_PATH=/etc/tron-signer/tls/server.key
TRON_SIGNER_TLS_CERT_PATH=/etc/tron-signer/tls/server.crt
TRON_SIGNER_CLIENT_CA_PATH=/etc/tron-signer/tls/client-ca.crt

# Double lock: remains false through installation and testing.
TRON_SIGNER_WRITES_ENABLED=false
TRON_SIGNER_MAX_PER_TX_USDT=100
TRON_SIGNER_MAX_DAILY_USDT=500
TRON_SIGNER_MIN_TRX_RESERVE=40
TRON_SIGNER_FEE_LIMIT_SUN=40000000
TRON_SIGNER_MAX_HEAD_AGE_MS=180000
TRON_SIGNER_MIN_ACTIVE_PEERS=3

# Used only by install.sh to create firewall rules.
APP_ALLOWED_CIDR=10.10.0.2/32
ADMIN_SSH_CIDR=REPLACE_WITH_ADMIN_IP/32